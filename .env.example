# Copy this file to .env and fill in real values for your environment.
# Never commit .env - it is already excluded via .gitignore.
#
# Variable names only below; no real secrets or working defaults are
# checked into this file. Every value QSNext actually needs at runtime
# is documented in src/main/resources/application*.yml alongside the
# ${VAR_NAME:default} it resolves.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=
SERVER_PORT=

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Only used by docker-compose.yml to name/create the database and
# publish its port - the application itself only reads DB_URL.
DB_NAME=
DB_PORT=
DB_POOL_MAX_SIZE=
DB_POOL_MIN_IDLE=

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Only used by docker-compose.yml to publish the management UI port.
RABBITMQ_MANAGEMENT_PORT=

# ------------------------------------------------------------
# Mail / SMTP
# ------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=

# ------------------------------------------------------------
# JWT / Authentication
# ------------------------------------------------------------
# Required, no default. Use a long, random, unique-per-environment
# value (e.g. `openssl rand -base64 48`) - never reuse the test-only
# secret in application-test.yml.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=
JWT_REFRESH_TOKEN_EXPIRATION=
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=
AUTH_ACCOUNT_LOCK_DURATION_MINUTES=
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=

# ------------------------------------------------------------
# Caching / rate limiting
# ------------------------------------------------------------
CACHE_DEFAULT_TTL_MINUTES=
CACHE_USER_PRINCIPAL_TTL_MINUTES=
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
# Comma-separated IPs/CIDRs of trusted reverse proxies/load balancers this
# app sits behind, if any. Leave empty unless genuinely deployed behind one -
# X-Forwarded-For is only honoured when the request's own peer matches an
# entry here.
SECURITY_TRUSTED_PROXIES=

# ------------------------------------------------------------
# Email delivery (outbox/consumer)
# ------------------------------------------------------------
EMAIL_FROM_ADDRESS=
EMAIL_CONSUMER_MAX_ATTEMPTS=
EMAIL_CONSUMER_INITIAL_INTERVAL_MS=
EMAIL_CONSUMER_BACKOFF_MULTIPLIER=
EMAIL_CONSUMER_MAX_INTERVAL_MS=
EMAIL_OUTBOX_SWEEP_INTERVAL_MS=
EMAIL_OUTBOX_STUCK_THRESHOLD_SECONDS=
EMAIL_OUTBOX_SWEEP_BATCH_SIZE=

# ------------------------------------------------------------
# Documents
# ------------------------------------------------------------
DOCUMENT_STORAGE_LOCAL_BASE_PATH=
DOCUMENT_MAX_FILE_SIZE=
DOCUMENT_MAX_REQUEST_SIZE=

# ------------------------------------------------------------
# AI (see za.co.qsnext.employeemanagement.ai) - optional. Left unset,
# QSNext runs with AI capabilities safely disabled (NoOpAiProvider).
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
QSNEXT_AI_MODEL=

# ------------------------------------------------------------
# Production-only (application-prod.yml)
# ------------------------------------------------------------
API_DOCS_ENABLED=
SWAGGER_UI_ENABLED=
